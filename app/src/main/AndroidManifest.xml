<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="au.com.michaelcarey.artouchpad" />
        <package android:name="au.com.michaelcarey.artouchpad.debug" />
    </queries>

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Required to trigger the haptic feedback vibrator on click/right-click gestures. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Display-scoped wake lock that keeps the glasses awake while the touchpad is open
         (see DisplayWakeLock); FLAG_KEEP_SCREEN_ON only covers the phone's own display. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- External settings overlay; enabled for this variant through the Shizuku service. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARTouchpad">

        <!-- Single-activity app; portrait-locked so the touchpad surface stays stable. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku content provider: required by the Shizuku library to communicate with
             the Shizuku daemon. It handles the binder handshake so our app can bind
             MouseService as a shell-uid UserService without needing root. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
